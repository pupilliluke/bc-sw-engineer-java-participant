# Copy to .env and set real lab-only values. .env is gitignored, never commit it.
# POSTGRES_USER is the container bootstrap superuser, deliberately NOT crm_app.
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=
POSTGRES_DB=crm41

# Least-privilege application role created by ddl/01_create_user.sql.
CRM_APP_USER=crm_app
CRM_APP_PASSWORD=

# Spring imports this file via spring.config.import and reads these. The URL and
# username have defaults in application.yml; CRM_APP_PASSWORD above has none, so
# a missing value fails at startup instead of falling back to something.
CRM_DB_URL=jdbc:postgresql://localhost:5432/crm41
CRM_DB_USERNAME=crm_app

# Connection target for psql.
CRM_DB_HOST=localhost
CRM_DB_PORT=5432

